---
// Riksväg 40 from our office in Mölndal to Borås. A dot drives the road when
// the section scrolls into view. Stops are real places along the route.
---
<div class="route" data-route>
  <svg class="map" viewBox="0 0 640 200" role="img" aria-labelledby="route-t" data-decor>
    <title id="route-t">Karta: vägen från vårt kontor i Mölndal till Borås, ungefär sex mil längs riksväg 40.</title>
    <defs>
      <linearGradient id="road" x1="0" x2="1">
        <stop offset="0" stop-color="#2F354A" />
        <stop offset="1" stop-color="#0CB183" />
      </linearGradient>
    </defs>
    <path id="rv40" d="M40 140 C 140 150, 170 70, 270 92 S 420 150, 470 100 S 560 50, 600 64"
      fill="none" stroke="#E2E4EA" stroke-width="14" stroke-linecap="round" />
    <path class="drive" d="M40 140 C 140 150, 170 70, 270 92 S 420 150, 470 100 S 560 50, 600 64"
      fill="none" stroke="url(#road)" stroke-width="6" stroke-linecap="round" pathLength="1" />
    <path d="M40 140 C 140 150, 170 70, 270 92 S 420 150, 470 100 S 560 50, 600 64"
      fill="none" stroke="#fff" stroke-width="1.5" stroke-dasharray="6 9" opacity=".9" />

    <g class="stop" style="--d:0s"><circle cx="40" cy="140" r="9" fill="#2F354A" /><text x="40" y="178" text-anchor="middle">Mölndal</text><text class="sub" x="40" y="194" text-anchor="middle">vårt kontor</text></g>
    <g class="stop" style="--d:.5s"><circle cx="205" cy="88" r="5" fill="#fff" stroke="#2F354A" stroke-width="2" /><text x="205" y="66" text-anchor="middle">Landvetter</text></g>
    <g class="stop" style="--d:1s"><circle cx="420" cy="128" r="5" fill="#fff" stroke="#2F354A" stroke-width="2" /><text x="420" y="160" text-anchor="middle">Bollebygd</text></g>
    <g class="stop" style="--d:1.6s"><circle cx="600" cy="64" r="11" fill="#0FE9AD" stroke="#0CB183" stroke-width="2" /><text x="600" y="36" text-anchor="middle" class="big">Borås</text></g>

    <g class="sign" transform="translate(300 140)">
      <rect x="-20" y="-14" width="40" height="28" rx="5" fill="#2F354A" />
      <text x="0" y="5" text-anchor="middle" fill="#fff" class="rv">40</text>
    </g>

    <circle class="car" r="8" fill="#FF808B" stroke="#fff" stroke-width="3">
      <animateMotion dur="2.4s" fill="freeze" begin="indefinite" calcMode="spline"
        keyTimes="0;1" keySplines=".45 0 .2 1" data-motion>
        <mpath href="#rv40" />
      </animateMotion>
    </circle>
  </svg>
  <p class="robot-comment" data-robot-only>&lt;!-- Karta: Mölndal till Borås, ungefär sex mil längs riksväg 40. --&gt;</p>
</div>

<style>
  .map { width: 100%; height: auto; overflow: visible; }
  .map text { font: 600 14px var(--font); fill: var(--navy); }
  .map text.sub { font-size: 11px; font-weight: 500; fill: var(--muted); }
  .map text.big { font-size: 18px; font-weight: 700; }
  .map text.rv { font-size: 15px; font-weight: 700; fill: #fff; }
  .drive { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .route.is-on .drive { transition: stroke-dashoffset 2.4s cubic-bezier(.45, 0, .2, 1); stroke-dashoffset: 0; }
  .stop { opacity: 0; transform: translateY(6px); transform-box: fill-box; }
  .route.is-on .stop { opacity: 1; transform: none; transition: opacity .5s var(--d), transform .5s var(--d); }
  .car { transform: translate(40px, 140px); }
  .route.is-on .car { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .drive { stroke-dashoffset: 0; }
    .stop { opacity: 1; transform: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-route]').forEach((el) => {
    const motion = el.querySelector<SVGAnimateMotionElement>('[data-motion]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const io = new IntersectionObserver(([en]) => {
      if (!en.isIntersecting) return;
      io.disconnect();
      el.classList.add('is-on');
      if (reduce) { const car = el.querySelector<SVGElement>('.car'); if (car) car.style.transform = 'translate(600px, 64px)'; return; }
      try { (motion as any)?.beginElement(); } catch (e) {}
    }, { threshold: .5 });
    io.observe(el);
  });
</script>
