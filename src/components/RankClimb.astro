---
// Hero toy: your business sits on page 2 for a local search. Drag it to the top,
// or wait and it climbs on its own. Competitors are anonymous skeleton rows on
// purpose, so no real company is ever shown ranking below anyone.
const rows = [
  { t: 72, d: [92, 64] },
  { t: 58, d: [88, 70] },
  { t: 80, d: [95, 52] },
  { t: 64, d: [84, 66] },
  { t: 70, d: [90, 58] },
  { t: 55, d: [86, 62] },
];
---
<div class="climb" data-climb>
  <div class="win" data-decor>
    <div class="win-top" aria-hidden="true">
      <span></span><span></span><span></span>
      <em>Sök</em>
    </div>

    <div class="query" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <span data-query>rörmokare borås</span><span class="caret"></span>
    </div>

    <div class="results" data-results>
      {rows.map((r, i) => (
        <div class="row comp" data-comp style={`--i:${i}`} aria-hidden="true">
          <span class="bar url" style="width:34%"></span>
          <span class="bar title" style={`width:${r.t}%`}></span>
          <span class="bar desc" style={`width:${r.d[0]}%`}></span>
        </div>
      ))}
      <div class="divider" data-divider aria-hidden="true"><span>Sida 2</span></div>
      <div class="row you" data-you tabindex="0" role="slider"
        aria-label="Ditt företags placering i sökresultatet. Dra uppåt eller använd piltangenterna."
        aria-valuemin="1" aria-valuemax="14" aria-valuenow="14" aria-valuetext="Plats 14, sida 2">
        <span class="grip" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="you-url">dittforetag.se</span>
        <span class="you-title"><span data-trade>Rörmokare</span> i Borås | Ditt företag</span>
        <span class="you-desc">Det här är du. Lokalt, pålitligt och lätt att hitta.</span>
        <span class="rank" data-rank>#14</span>
      </div>
    </div>

    <div class="foot">
      <p class="hint" data-hint><span class="arrow" aria-hidden="true">↑</span> Dra upp ditt företag</p>
      <p class="done" data-done>Där ja. Först i Borås.</p>
      <button type="button" class="again" data-again>Igen</button>
    </div>
    <div class="burst" data-burst aria-hidden="true"></div>
  </div>

  <p class="robot-comment" data-robot-only>
    &lt;!-- Här ser människor en interaktiv sökruta där ditt företag klättrar från plats 14 till plats 1.
    En sökmotor ser ingenting av det. Den läser bara texten runt omkring. Därför skriver vi texten först. --&gt;
  </p>
</div>

<style>
  .climb { position: relative; }
  .win {
    position: relative; background: #fff; border: 1px solid var(--line); border-radius: 16px;
    box-shadow: var(--shadow-lift); overflow: hidden; touch-action: pan-y;
  }
  .win-top { display: flex; align-items: center; gap: 6px; padding: 12px 16px; background: var(--mist); border-bottom: 1px solid var(--line); }
  .win-top span { width: 10px; height: 10px; border-radius: 50%; background: #d5d8e0; }
  .win-top span:first-child { background: var(--coral); }
  .win-top em { margin-left: auto; font-style: normal; font-size: .75rem; font-weight: 600; color: var(--muted); letter-spacing: .06em; text-transform: uppercase; }

  .query {
    display: flex; align-items: center; gap: 10px; margin: 16px 16px 6px;
    padding: 12px 16px; border: 1.5px solid var(--line); border-radius: 999px;
    color: var(--navy); font-weight: 500; font-size: .98rem;
  }
  .query svg { color: var(--muted); flex: none; }
  .caret { width: 2px; height: 1.1em; background: var(--navy); margin-left: -6px; animation: caret 1s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }

  .results { --h: 66px; --g: 8px; --dv: 34px; position: relative; margin: 10px 16px 0; height: calc(7 * var(--h) + 6 * var(--g) + var(--dv)); }
  .row {
    position: absolute; left: 0; right: 0; height: var(--h);
    padding: 10px 14px; border-radius: 10px;
    display: grid; align-content: center; gap: 6px;
    transition: transform .55s var(--ease);
    will-change: transform;
  }
  .comp { background: #fff; }
  .bar { display: block; height: 7px; border-radius: 4px; background: #E8EAF0; }
  .bar.url { height: 5px; background: #EFF1F5; }
  .bar.title { height: 9px; background: #D7DBE6; }

  .divider { position: absolute; left: 0; right: 0; height: var(--dv); display: flex; align-items: center; transition: opacity .4s; }
  .divider::before { content: ''; flex: 1; border-top: 1.5px dashed var(--line); }
  .divider span {
    position: absolute; left: 50%; transform: translateX(-50%); background: #fff; padding: 0 10px;
    font-size: .72rem; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; color: var(--muted);
  }

  .you {
    z-index: 2; background: var(--mint-wash); border: 1.5px solid var(--mint);
    padding: 8px 64px 8px 34px; gap: 1px; cursor: grab; user-select: none;
    box-shadow: 0 8px 24px rgba(12, 177, 131, .18);
  }
  .you.dragging { cursor: grabbing; transition: none; box-shadow: 0 18px 40px rgba(12, 177, 131, .32); }
  .you-url { font-size: .7rem; color: var(--muted); line-height: 1.2; }
  .you-title { font-weight: 650; color: var(--navy); font-size: .95rem; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .you-desc { font-size: .78rem; color: var(--muted); line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .grip { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); display: grid; gap: 3px; }
  .grip i { width: 12px; height: 2px; background: var(--mint-dark); border-radius: 2px; }
  .rank {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    min-width: 42px; padding: 5px 8px; border-radius: 8px; text-align: center;
    background: var(--navy); color: #fff; font-weight: 700; font-size: .9rem; font-variant-numeric: tabular-nums;
    transition: background .3s, color .3s, transform .3s var(--ease);
  }
  .you.top .rank { background: var(--mint); color: var(--navy-ink); transform: translateY(-50%) scale(1.12); }

  .foot { display: flex; align-items: center; gap: 12px; min-height: 58px; padding: 10px 18px 16px; }
  .hint, .done { margin: 0; font-size: .9rem; font-weight: 600; color: var(--navy); }
  .hint .arrow { display: inline-block; color: var(--mint-dark); animation: nudge 1.4s var(--ease) infinite; }
  @keyframes nudge { 50% { transform: translateY(-5px); } }
  .done { display: none; }
  .again {
    margin-left: auto; display: none; background: none; border: 1px solid var(--line); border-radius: 999px;
    padding: 6px 14px; font: 600 .8rem var(--font); color: var(--navy); cursor: pointer;
  }
  .again:hover { border-color: var(--navy); }
  .win.is-top .hint { display: none; }
  .win.is-top .done, .win.is-top .again { display: block; }

  .burst { position: absolute; inset: 0; pointer-events: none; }
  .burst :global(i) {
    position: absolute; width: 8px; height: 8px; border-radius: 2px;
    animation: fly .9s var(--ease) forwards;
  }
  @keyframes fly {
    from { transform: translate(0, 0) rotate(0); opacity: 1; }
    to { transform: translate(var(--x), var(--y)) rotate(var(--r)); opacity: 0; }
  }

  @media (max-width: 480px) {
    .results { --h: 60px; --g: 6px; margin-inline: 10px; }
    .query { margin-inline: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .row { transition: none; }
    .hint .arrow, .caret { animation: none; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-climb]').forEach((root) => {
    const win = root.querySelector<HTMLElement>('.win')!;
    const results = root.querySelector<HTMLElement>('[data-results]')!;
    const comps = [...root.querySelectorAll<HTMLElement>('[data-comp]')];
    const you = root.querySelector<HTMLElement>('[data-you]')!;
    const divider = root.querySelector<HTMLElement>('[data-divider]')!;
    const rankEl = root.querySelector<HTMLElement>('[data-rank]')!;
    const burst = root.querySelector<HTMLElement>('[data-burst]')!;
    const queryEl = root.querySelector<HTMLElement>('[data-query]')!;
    const tradeEl = root.querySelector<HTMLElement>('[data-trade]')!;

    const SLOTS = 7; // 0..5 page one, 6 is page two
    let progress = 0; // 0 = page two, 1 = first place
    let touched = false;
    let celebrated = false;

    const metrics = () => {
      const cs = getComputedStyle(results);
      return { h: parseFloat(cs.getPropertyValue('--h')), g: parseFloat(cs.getPropertyValue('--g')), dv: parseFloat(cs.getPropertyValue('--dv')) };
    };
    const yOf = (slot: number, m = metrics()) => slot * (m.h + m.g) + (slot >= 6 ? m.dv : 0);
    const slotOf = (p: number) => Math.round((1 - p) * (SLOTS - 1));

    function layout(continuous = false) {
      const m = metrics();
      const slot = slotOf(progress);
      // Competitors fill the slots the user is not in
      let s = 0;
      comps.forEach((c) => {
        if (s === slot) s++;
        c.style.transform = `translateY(${yOf(s, m)}px)`;
        s++;
      });
      divider.style.transform = `translateY(${yOf(6, m) - m.dv + (m.g / 2) - 4}px)`;
      const y = continuous ? yOf(6, m) + (yOf(0, m) - yOf(6, m)) * progress : yOf(slot, m);
      you.style.transform = `translateY(${y}px)`;
      const rank = slot === 6 ? 14 : slot + 1;
      rankEl.textContent = `#${rank}`;
      you.setAttribute('aria-valuenow', String(rank));
      you.setAttribute('aria-valuetext', rank === 14 ? 'Plats 14, sida 2' : `Plats ${rank}`);
      you.classList.toggle('top', rank === 1);
      win.classList.toggle('is-top', rank === 1);
      if (rank === 1 && !celebrated) { celebrated = true; celebrate(); }
      if (rank !== 1) celebrated = false;
    }

    function celebrate() {
      if (reduce) return;
      const r = you.getBoundingClientRect(), w = win.getBoundingClientRect();
      const cx = r.right - w.left - 32, cy = r.top - w.top + r.height / 2;
      const colors = ['#0FE9AD', '#0CB183', '#FF808B', '#2F354A'];
      for (let i = 0; i < 26; i++) {
        const p = document.createElement('i');
        const a = Math.random() * Math.PI * 2, d = 50 + Math.random() * 110;
        p.style.left = `${cx}px`; p.style.top = `${cy}px`;
        p.style.background = colors[i % colors.length];
        p.style.setProperty('--x', `${Math.cos(a) * d}px`);
        p.style.setProperty('--y', `${Math.sin(a) * d - 30}px`);
        p.style.setProperty('--r', `${Math.random() * 540 - 270}deg`);
        burst.appendChild(p);
        setTimeout(() => p.remove(), 1000);
      }
    }

    function animateTo(target: number, ms = 2600) {
      if (reduce) { progress = target; layout(); return; }
      const from = progress, start = performance.now();
      let lastSlot = slotOf(progress);
      const tick = (t: number) => {
        const k = Math.min(1, (t - start) / ms);
        const e = k < .5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
        progress = from + (target - from) * e;
        const sl = slotOf(progress);
        if (sl !== lastSlot) { lastSlot = sl; layout(); }
        if (k < 1 && !touched) requestAnimationFrame(tick); else layout();
      };
      requestAnimationFrame(tick);
    }

    /* Dragging */
    let startY = 0, startP = 0, dragging = false;
    you.addEventListener('pointerdown', (e) => {
      touched = true; dragging = true; startY = e.clientY; startP = progress;
      you.setPointerCapture(e.pointerId); you.classList.add('dragging');
    });
    you.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const m = metrics();
      const span = yOf(6, m) - yOf(0, m);
      progress = Math.max(0, Math.min(1, startP + (startY - e.clientY) / span));
      layout(true);
    });
    const end = () => { if (!dragging) return; dragging = false; you.classList.remove('dragging'); layout(); };
    you.addEventListener('pointerup', end);
    you.addEventListener('pointercancel', end);

    /* Keyboard */
    you.addEventListener('keydown', (e) => {
      const step = 1 / (SLOTS - 1);
      if (e.key === 'ArrowUp') { touched = true; progress = Math.min(1, progress + step); layout(); e.preventDefault(); }
      if (e.key === 'ArrowDown') { touched = true; progress = Math.max(0, progress - step); layout(); e.preventDefault(); }
      if (e.key === 'Home') { touched = true; progress = 1; layout(); e.preventDefault(); }
      if (e.key === 'End') { touched = true; progress = 0; layout(); e.preventDefault(); }
    });

    root.querySelector('[data-again]')?.addEventListener('click', () => {
      progress = 0; layout(); touched = false;
      setTimeout(() => animateTo(1), 500);
    });

    /* Auto climb once the toy is on screen and nobody touched it */
    const io = new IntersectionObserver(([en]) => {
      if (!en.isIntersecting) return;
      io.disconnect();
      setTimeout(() => { if (!touched) animateTo(1); }, 2600);
    }, { threshold: .6 });
    io.observe(win);

    addEventListener('resize', () => layout());
    layout();

    /* Typewriter search queries */
    const queries = ['rörmokare borås', 'redovisningsbyrå borås', 'frisör borås', 'elektriker borås', 'takläggare borås', 'bilverkstad borås'];
    let qi = 0;
    const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
    async function typeLoop() {
      if (reduce) return;
      const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
      while (true) {
        await wait(4200);
        if (document.hidden) continue;
        const next = queries[++qi % queries.length];
        let cur = queryEl.textContent || '';
        while (cur.length) { cur = cur.slice(0, -1); queryEl.textContent = cur; await wait(28); }
        for (const ch of next) { cur += ch; queryEl.textContent = cur; await wait(55 + Math.random() * 60); }
        tradeEl.textContent = cap(next.replace(/ borås$/, ''));
      }
    }
    typeLoop();
  });
</script>
