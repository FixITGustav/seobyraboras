---
// Page top: the small text is the H1 (the SEO heading), the big line is an H2
// that only looks like a headline. Every part is optional.
import Highlight from './Highlight.astro';
import Opt from './Opt.astro';
interface Props {
  h1?: string;
  rubrik?: string;
  markering?: string;
  ingress?: string;
}
const { h1, rubrik, markering, ingress } = Astro.props;
---
<Opt as="h1" class="eyebrow" text={h1} />
{rubrik?.trim() && <h2 class="display"><Highlight text={rubrik.trim()} mark={markering?.trim()} /></h2>}
<Opt as="p" class="lead" text={ingress} />
