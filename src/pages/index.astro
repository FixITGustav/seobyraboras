---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import RankClimb from '../components/RankClimb.astro';
import Route40 from '../components/Route40.astro';
import PeopleAlsoAsk from '../components/PeopleAlsoAsk.astro';
import Hero from '../components/Hero.astro';
import Opt from '../components/Opt.astro';
import data from '../content/hem.json';
import site from '../content/installningar.json';
import { resolveImage, paragraphs, telHref, list } from '../lib/content';

// Every field is optional in the CMS, so read everything defensively
const c: any = data ?? {};
const seo = c.seo ?? {};
const hero = c.hero ?? {};
const tj = c.tjanster ?? {};
const robot = c.robot ?? {};
const proc = c.process ?? {};
const boras = c.boras ?? {};
const fq = c.faq ?? {};
const cta = c.cta ?? {};

const faq = list(fq.fragor).filter((f: any) => f?.fraga?.trim() && f?.svar?.trim()).map((f: any) => ({ q: f.fraga.trim(), a: f.svar.trim() }));
const faqSchema = faq.length ? [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}] : [];
const borasImage = resolveImage(boras.bild);
const steps = list(proc.steg);
const trust = list(hero.fortroende);
---
<Base
  title={seo.titel}
  fallbackTitle={hero.h1}
  description={seo.beskrivning}
  shareImage={seo.delningsbild}
  shareImageAlt={seo.delningsbild_alt}
  path="/"
  schema={faqSchema}
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <Hero h1={hero.h1} rubrik={hero.rubrik} markering={hero.rubrik_markering} ingress={hero.ingress} />
        <div class="btn-row">
          {hero.knapp?.trim() && <a class="btn" href="/kontakt/">{hero.knapp}</a>}
          {site.telefon && <a class="btn btn--ghost" href={telHref(site.telefon)}>Ring {site.telefon}</a>}
        </div>
        {trust.length > 0 && (
          <ul class="proof">
            {trust.map((p: any) => <li><strong>{p.rubrik}</strong><Opt as="span" text={p.text} /></li>)}
          </ul>
        )}
      </div>
      <div class="hero-toy">
        <RankClimb />
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section section--mist" id="tjanster">
    <div class="wrap">
      <div class="head" data-reveal>
        <Opt class="eyebrow" text={tj.overrubrik} />
        <Opt as="h2" text={tj.rubrik} />
        <Opt class="lead" text={tj.ingress} />
      </div>
      <div class="cards">
        {list(tj.lista).map((s: any, i: number) => (
          <article class="card" data-reveal style={`transition-delay:${(i % 3) * 90}ms`}>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <Opt as="h3" text={s.rubrik} />
            <Opt text={s.text} />
            {s.sokning?.trim() && <p class="query"><span class="q-icon" aria-hidden="true"></span><span class="q-label">Typisk sökning:</span> <span class="q-text">{s.sokning}</span></p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ROBOT INVITE -->
  <section class="section section--navy invite">
    <div class="wrap invite-grid">
      <div data-reveal>
        <Opt class="eyebrow" text={robot.overrubrik} />
        <Opt as="h2" text={robot.rubrik} />
        <Opt class="lead" text={robot.text} />
        <button class="btn btn--mint" type="button" data-robot-invite>
          <span class="when-human-i">{robot.knapp?.trim() || 'Visa robotläget'}</span><span class="when-robot-i">Tillbaka till människoläget</span>
        </button>
      </div>
      <div class="scan" aria-hidden="true" data-decor>
        <div class="scan-doc">
          <span class="tag">&lt;title&gt;</span><span class="ln w80"></span>
          <span class="tag">&lt;h1&gt;</span><span class="ln w60 hi"></span>
          <span class="tag">&lt;p&gt;</span><span class="ln w95"></span><span class="ln w90"></span><span class="ln w70"></span>
          <span class="tag">&lt;h2&gt;</span><span class="ln w50 hi"></span>
          <span class="tag">&lt;a&gt;</span><span class="ln w40 link"></span>
          <span class="tag">&lt;p&gt;</span><span class="ln w85"></span><span class="ln w65"></span>
        </div>
        <div class="beam"></div>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section" id="sa-funkar-det">
    <div class="wrap">
      <div class="head" data-reveal>
        <Opt class="eyebrow" text={proc.overrubrik} />
        <Opt as="h2" text={proc.rubrik} />
        <Opt class="lead" text={proc.ingress} />
      </div>
      {steps.length > 0 && (
        <ol class="steps" data-steps style={`--cols:${Math.min(4, steps.length)}`}>
          {steps.map((s: any, i: number) => (
            <li class="step" data-reveal style={`transition-delay:${i * 140}ms`}>
              <span class="dot" aria-hidden="true">{i + 1}</span>
              <Opt as="h3" text={s.rubrik} />
              <Opt text={s.text} />
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>

  <!-- BORÅS -->
  <section class="section section--mist">
    <div class="wrap boras">
      <div data-reveal>
        <Opt class="eyebrow" text={boras.overrubrik} />
        <Opt as="h2" text={boras.rubrik} />
        {paragraphs(boras.text).map((p) => <p>{p}</p>)}
        <a class="btn btn--ghost" href="/om-oss/">Läs mer om oss</a>
      </div>
      <div data-reveal class="boras-visual">
        {borasImage && (
          <Image src={borasImage} alt={boras.bild_alt || ''} widths={[480, 720, 960, 1280]} sizes="(max-width: 960px) 100vw, 560px" class="boras-img" />
        )}
        <Route40 />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  {faq.length > 0 && (
    <section class="section" id="fragor">
      <div class="wrap faq">
        <div class="head" data-reveal>
          <Opt class="eyebrow" text={fq.overrubrik} />
          <Opt as="h2" text={fq.rubrik} />
          <Opt class="lead" text={fq.ingress} />
        </div>
        <PeopleAlsoAsk items={faq} start={4} />
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="section section--navy cta">
    <div class="wrap cta-inner" data-reveal>
      <Opt as="h2" text={cta.rubrik} />
      <Opt class="lead" text={cta.text} />
      <div class="btn-row">
        <a class="btn btn--mint" href="/kontakt/">{cta.knapp?.trim() || 'Kontakta oss'}</a>
        {site.epost && <a class="btn btn--ghost cta-ghost" href={`mailto:${site.epost}`}>{site.epost}</a>}
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { position: relative; padding: clamp(40px, 7vw, 88px) 0 clamp(64px, 9vw, 112px); overflow: hidden; }
  .hero::before {
    content: ''; position: absolute; right: -10%; top: -30%; width: 70%; aspect-ratio: 1;
    background: radial-gradient(closest-side, rgba(15, 233, 173, .16), transparent 70%);
    pointer-events: none;
  }
  .hero-grid { position: relative; display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .hero :global(.display) { margin-bottom: .45em; }
  .hero .lead { margin-bottom: 1.8em; }
  .proof { list-style: none; margin: 40px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 14px 32px; }
  .proof li { display: grid; padding-left: 14px; border-left: 2px solid var(--mint); line-height: 1.35; }
  .proof strong { color: var(--navy); font-size: .98rem; }
  .proof span { font-size: .84rem; color: var(--muted); }

  .head { max-width: 46em; margin-bottom: clamp(32px, 5vw, 56px); }

  /* SERVICES */
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .card { min-width: 0; }
  .card {
    position: relative; background: #fff; border: 1px solid var(--line); border-radius: 14px;
    padding: 28px 26px 22px; display: flex; flex-direction: column;
    transition: transform .35s var(--ease), box-shadow .35s var(--ease), border-color .35s, opacity .8s var(--ease);
  }
  .card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lift); border-color: transparent; }
  .num { font-size: .8rem; font-weight: 700; color: var(--mint-dark); letter-spacing: .06em; margin-bottom: 14px; }
  .card h3 { margin-bottom: .5em; }
  .card p { color: var(--muted); font-size: .97rem; }
  .query {
    margin: auto 0 0 !important; padding: 10px 12px; border-radius: 999px; background: var(--mist);
    display: flex; align-items: center; gap: 8px; font-size: .84rem !important; color: var(--navy) !important;
    overflow: hidden; white-space: nowrap;
  }
  .q-icon { width: 11px; height: 11px; border: 2px solid var(--muted); border-radius: 50%; position: relative; flex: none; }
  .q-icon::after { content: ''; position: absolute; width: 2px; height: 6px; background: var(--muted); right: -4px; bottom: -5px; transform: rotate(-45deg); }
  .q-label { color: var(--muted); }
  .q-text {
    font-weight: 600; overflow: hidden; text-overflow: ellipsis;
    background: linear-gradient(90deg, var(--navy) 50%, var(--muted) 50%) 100% 0 / 200% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    transition: background-position .9s var(--ease);
  }
  .card:hover .q-text { background-position: 0 0; }

  /* ROBOT INVITE */
  .invite-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .invite .lead { margin-bottom: 1.6em; }
  .when-robot-i { display: none; }
  :global(html.robot) .when-human-i { display: none; }
  :global(html.robot) .when-robot-i { display: inline; }
  .scan { position: relative; border-radius: 16px; overflow: hidden; background: #262b3e; border: 1px solid #3a4058; padding: 26px; }
  .scan-doc { display: grid; grid-template-columns: auto 1fr; gap: 10px 14px; align-items: center; font: 12px var(--mono); }
  .scan-doc .tag { color: var(--coral); grid-column: 1; }
  .scan-doc .ln { grid-column: 2; height: 8px; border-radius: 4px; background: #3d4460; }
  .ln.hi { background: #fff; height: 10px; }
  .ln.link { background: var(--mint); }
  .w95 { width: 95%; } .w90 { width: 90%; } .w85 { width: 85%; } .w80 { width: 80%; } .w70 { width: 70%; } .w65 { width: 65%; } .w60 { width: 60%; } .w50 { width: 50%; } .w40 { width: 40%; }
  .beam {
    position: absolute; left: 0; right: 0; height: 60px; top: -60px;
    background: linear-gradient(transparent, rgba(15, 233, 173, .22) 70%, var(--mint));
    border-bottom: 2px solid var(--mint);
    animation: beam 3.2s cubic-bezier(.6, 0, .4, 1) infinite;
  }
  @keyframes beam { 0% { top: -60px; } 70%, 100% { top: 100%; } }

  /* PROCESS */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); gap: 28px; position: relative; counter-reset: s; }
  .steps::before {
    content: ''; position: absolute; left: 22px; right: 22px; top: 22px; height: 2px;
    background: linear-gradient(90deg, var(--mint), var(--mint-dark));
    transform: scaleX(0); transform-origin: left; transition: transform 1.4s var(--ease) .2s;
  }
  .steps:has(.is-in)::before { transform: scaleX(1); }
  .step { position: relative; }
  .dot {
    position: relative; z-index: 1; display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%;
    background: var(--navy); color: #fff; font-weight: 700; margin-bottom: 20px; box-shadow: 0 0 0 6px #fff;
  }
  .step p { color: var(--muted); }

  /* BORÅS */
  .boras { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .boras p { color: var(--muted); }
  .boras .btn { margin-top: .6em; }
  .boras-visual { display: grid; gap: 24px; }
  .boras-img { width: 100%; height: auto; border-radius: 16px; box-shadow: var(--shadow); }

  /* FAQ */
  .faq > :global(*) { max-width: 860px; }

  /* CTA */
  .cta { text-align: center; }
  .cta-inner { display: grid; justify-items: center; }
  .cta .lead { margin-inline: auto; margin-bottom: 1.6em; }
  .cta .btn-row { justify-content: center; }
  .cta-ghost { --fg: #fff; --bd: #6b728c; text-transform: none; letter-spacing: 0; }
  .cta-ghost:hover { background: #fff; --fg: var(--navy); }

  @media (max-width: 960px) {
    .hero-grid, .invite-grid, .boras { grid-template-columns: 1fr; }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero-toy { max-width: 560px; }
  }
  @media (max-width: 640px) {
    .cards { grid-template-columns: minmax(0, 1fr); }
    .steps { grid-template-columns: 1fr; gap: 8px; }
    .steps::before { left: 22px; right: auto; top: 22px; bottom: 40px; width: 2px; height: auto; transform: scaleY(0); transform-origin: top; }
    .steps:has(.is-in)::before { transform: scaleY(1); }
    .step { padding-left: 68px; }
    .dot { position: absolute; left: 0; top: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .beam { animation: none; display: none; } }

  :global(html.robot) .card { background: transparent; border: 1px dashed #343a52; }
  :global(html.robot) .card:hover { transform: none; box-shadow: none; }
  :global(html.robot) .query { background: transparent; padding: 0; }
  :global(html.robot) .q-text { color: var(--mint); background: none; }
  :global(html.robot) .q-icon { display: none; }
  :global(html.robot) .dot { background: transparent; box-shadow: none; border: 1px dashed var(--mint); color: var(--mint); }
  :global(html.robot) .steps::before { display: none; }
  :global(html.robot) .hero::before { display: none; }
  :global(html.robot) .proof li { border-color: #343a52; }
  :global(html.robot) .proof strong { color: #fff; }
</style>

<script>
  document.querySelector('[data-robot-invite]')?.addEventListener('click', () => {
    document.querySelector<HTMLButtonElement>('[data-robot-toggle]')?.click();
    window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  });
</script>
