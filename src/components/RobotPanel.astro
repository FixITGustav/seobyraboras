---
// A floating notebook that only exists in robot mode. Everything in it is read
// live from the page itself, so it is an honest mini audit of the page you are on.
---
<aside class="robot-panel" data-robot-panel aria-live="polite" aria-label="Robotens anteckningar om sidan">
  <div class="rp-head">
    <span class="rp-dot" aria-hidden="true"></span>
    <strong>Robotens anteckningar</strong>
    <button type="button" class="rp-min" data-rp-min aria-label="Minimera">_</button>
  </div>
  <div class="rp-body">
    <div class="rp-serp">
      <span class="rp-url" data-rp-url></span>
      <span class="rp-title" data-rp-title></span>
      <span class="rp-desc" data-rp-desc></span>
    </div>
    <dl class="rp-stats">
      <div><dt>Title</dt><dd data-rp-tlen></dd></div>
      <div><dt>Description</dt><dd data-rp-dlen></dd></div>
      <div><dt>H1</dt><dd data-rp-h1></dd></div>
      <div><dt>Rubriker</dt><dd data-rp-hx></dd></div>
      <div><dt>Ord</dt><dd data-rp-words></dd></div>
      <div><dt>Interna länkar</dt><dd data-rp-int></dd></div>
      <div><dt>Externa länkar</dt><dd data-rp-ext></dd></div>
      <div><dt>Strukturerad data</dt><dd data-rp-schema></dd></div>
    </dl>
    <p class="rp-note">Allt ovan läses direkt från sidan du är på. Ingen fusk-data.</p>
  </div>
</aside>

<style>
  .robot-panel {
    position: fixed; right: 16px; bottom: 16px; z-index: 60;
    width: min(360px, calc(100vw - 32px));
    background: #12151f; color: #C8CCDA; font: 13px/1.5 var(--mono);
    border: 1px solid #343a52; border-radius: 12px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, .45);
    transform: translateY(calc(100% + 24px)); opacity: 0; pointer-events: none;
    transition: transform .5s var(--ease), opacity .3s;
  }
  :global(html.robot) .robot-panel { transform: none; opacity: 1; pointer-events: auto; }
  .robot-panel.is-min .rp-body { display: none; }
  .rp-head { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-bottom: 1px solid #262b3d; color: #fff; }
  .rp-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 0 4px rgba(15, 233, 173, .18); animation: pulse 1.8s infinite; }
  @keyframes pulse { 50% { box-shadow: 0 0 0 7px rgba(15, 233, 173, 0); } }
  .rp-min { margin-left: auto; background: none; border: 1px solid #343a52; color: #C8CCDA; border-radius: 6px; width: 28px; height: 24px; cursor: pointer; font: inherit; line-height: 1; }
  .rp-min::before { content: none !important; }
  .rp-body { padding: 12px; max-height: 60vh; overflow: auto; }
  .rp-serp { display: grid; gap: 2px; padding: 10px; background: #fff; border-radius: 8px; margin-bottom: 12px; font-family: Arial, sans-serif; }
  .rp-url { color: #3c4043; font-size: 12px; }
  .rp-title { color: #1a0dab; font-size: 17px; line-height: 1.3; }
  .rp-desc { color: #4d5156; font-size: 13px; line-height: 1.45; }
  .rp-stats { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .rp-stats div { background: #1a1e2c; border-radius: 6px; padding: 6px 8px; }
  .rp-stats dt { font-size: 11px; color: #7d849c; }
  .rp-stats dd { margin: 0; color: #fff; }
  .rp-stats :global(.ok) { color: var(--mint); }
  .rp-stats :global(.warn) { color: var(--coral); }
  .rp-note { margin: 10px 0 0; font-size: 11px; color: #7d849c; }
  .robot-panel :global(*::before), .robot-panel :global(*::after) { content: none !important; }
</style>
